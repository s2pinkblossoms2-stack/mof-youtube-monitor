# 필요한 환경변수 이름 목록이다. 값은 비워 두고, 실제 값은 .env(내 컴퓨터)와 Vercel 환경변수에만 넣는다.
# 이 파일에는 절대 실제 값을 적지 않는다.

# 유튜브 공개 정보 읽기
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# 채널 관리자 권한 (구독자 정확값, 댓글 삭제)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# 저장소 (서비스 실행 중 접속용. SUPABASE_ACCESS_TOKEN은 CLI 작업용이라 별개)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 댓글 분류와 답글 초안
OPENAI_API_KEY=

# 자동 실행 주소 보호
CRON_SECRET=

# 공유 비밀번호 접근 제한
APP_ACCESS_PASSWORD=
SESSION_SECRET=
